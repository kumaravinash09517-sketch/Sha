<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D">

    <!-- Remote Fullscreen Video View -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remote_surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Status Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp"
        android:background="#990A0F1D">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/app_icon_call"
            android:contentDescription="App Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_local_ip_banner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP: Detecting..."
                android:textColor="#38BDF8"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_copy_ip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_control_circle"
            android:src="@drawable/ic_copy"
            android:contentDescription="Copy Local IP"
            android:padding="10dp" />
    </LinearLayout>

    <!-- Local Floating PIP Video Card -->
    <FrameLayout
        android:id="@+id/local_surface_container"
        android:layout_width="110dp"
        android:layout_height="150dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="85dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_local_preview"
        android:clipToOutline="true"
        android:elevation="8dp">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/local_surface_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Connection & Dialing Overlay (shown when idle or preparing call) -->
    <ScrollView
        android:id="@+id/connect_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="75dp"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Title & Mode Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_wifi_tethering"
                    android:contentDescription="Hotspot Icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Offline Wi-Fi / Hotspot P2P"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline Video &amp; Audio Calling"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textAlignment="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Connect two phones directly over local Wi-Fi Hotspot without internet or cellular data."
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textAlignment="center"
                android:layout_marginBottom="20dp" />

            <!-- Local Device Server Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MY DEVICE (SIGNALING SERVER)"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_device_ip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="192.168.43.1"
                    android:textColor="#F8FAFC"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_server_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="● TCP Server listening on port 8888"
                    android:textColor="#22C55E"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Peer Connect Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONNECT &amp; CALL PEER"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Enter the IP address of the other phone"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_peer_ip"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:hint="e.g. 192.168.43.1"
                    android:textColorHint="#475569"
                    android:textColor="#FFFFFF"
                    android:inputType="textUri"
                    android:text="192.168.43.1"
                    android:textSize="15sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />

                <Button
                    android:id="@+id/btn_fill_hotspot_ip"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Use Default Hotspot IP (192.168.43.1)"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:padding="4dp" />

                <Button
                    android:id="@+id/btn_start_call"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_call"
                    android:text="START P2P VIDEO CALL"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Quick Instructions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOW TO CONNECT VIA HOTSPOT:"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Phone 1 turns on Portable Wi-Fi Hotspot (its IP will usually be 192.168.43.1)."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Phone 2 joins Phone 1's Wi-Fi Hotspot network."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Open My Assistant on both phones and tap Start Call!"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom In-Call Controls Overlay -->
    <LinearLayout
        android:id="@+id/call_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#D90A0F1D"
        android:paddingTop="12dp"
        android:paddingBottom="36dp"
        android:visibility="gone">

        <!-- Call Status Pill -->
        <TextView
            android:id="@+id/tv_call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Connecting..."
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- Control Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Mic Mute/Unmute -->
            <ImageButton
                android:id="@+id/btn_toggle_mic"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_control_circle"
                android:src="@drawable/ic_mic"
                android:contentDescription="Toggle Microphone"
                android:padding="14dp" />

            <!-- Video Camera Toggle -->
            <ImageButton
                android:id="@+id/btn_toggle_video"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_control_circle"
                android:src="@drawable/ic_videocam"
                android:contentDescription="Toggle Video Camera"
                android:padding="14dp" />

            <!-- Hang Up Button (Red) -->
            <ImageButton
                android:id="@+id/btn_hangup"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_button_hangup"
                android:src="@drawable/ic_call_end"
                android:contentDescription="End Call"
                android:padding="16dp" />

            <!-- Switch Front/Back Camera -->
            <ImageButton
                android:id="@+id/btn_switch_camera"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_control_circle"
                android:src="@drawable/ic_switch_camera"
                android:contentDescription="Flip Camera"
                android:padding="14dp" />

            <!-- Speakerphone Toggle -->
            <ImageButton
                android:id="@+id/btn_toggle_speaker"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_control_circle"
                android:src="@drawable/ic_volume_up"
                android:contentDescription="Toggle Speaker"
                android:padding="14dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
