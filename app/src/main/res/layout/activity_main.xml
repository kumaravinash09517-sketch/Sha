<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D">

    <!-- Remote Fullscreen Video View -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remote_surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Status Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp"
        android:background="#B30A0F1D">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/app_icon_call"
            android:contentDescription="App Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_local_ip_banner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My IP: Detecting..."
                android:textColor="#38BDF8"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_copy_ip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_control_circle"
            android:src="@drawable/ic_copy"
            android:contentDescription="Copy Local IP"
            android:padding="10dp" />
    </LinearLayout>

    <!-- Local Floating PIP Video Card -->
    <FrameLayout
        android:id="@+id/local_surface_container"
        android:layout_width="104dp"
        android:layout_height="142dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_local_preview"
        android:clipToOutline="true"
        android:elevation="8dp">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/local_surface_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Connection, Diagnostics & Controls Dashboard -->
    <ScrollView
        android:id="@+id/connect_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="78dp"
        android:layout_marginBottom="12dp"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="28dp"
            android:gravity="center_horizontal">

            <!-- Mode Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:background="@drawable/bg_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:gravity="center"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_wifi_tethering"
                    android:contentDescription="Hotspot Icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Offline Wi-Fi / Hotspot P2P"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Diagnostic Failure Alert Banner (Shown automatically when a call fails/disconnects) -->
            <LinearLayout
                android:id="@+id/diagnostic_error_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_error_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIAGNOSTIC ALERT: CALL DISCONNECTED"
                    android:textColor="#FCA5A5"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_diagnostic_reason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Inspecting connection..."
                    android:textColor="#FEE2E2"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Live Counters & Connection Health Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE NETWORK &amp; DIAGNOSTICS"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active Peers"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_active_peers_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#F8FAFC"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Incoming Status"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_incoming_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Listening :8888"
                            android:textColor="#22C55E"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Conn. Health"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_connection_health"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ready"
                            android:textColor="#38BDF8"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_device_ip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="My Hotspot IP: 192.168.43.1"
                    android:textColor="#F8FAFC"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_server_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="● TCP Signaling Server active on port 8888"
                    android:textColor="#22C55E"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Peer Connect & Call Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONNECT &amp; CALL PEER"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_peer_ip"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:hint="Peer IP (e.g. 192.168.43.1)"
                    android:textColorHint="#475569"
                    android:textColor="#FFFFFF"
                    android:inputType="textUri"
                    android:text="192.168.43.1"
                    android:textSize="15sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_fill_hotspot_ip"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Host IP (192.168.43.1)"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:gravity="start|center_vertical"
                        android:padding="4dp" />

                    <Button
                        android:id="@+id/btn_refresh_ip"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Refresh IP"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:padding="4dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_start_call"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_button_call"
                    android:text="START P2P VIDEO CALL"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- System & Hardware Controls Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HARDWARE &amp; SYSTEM CONTROLS"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_torch_toggle"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_secondary"
                        android:text="Torch: OFF"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_lock_screen"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_secondary"
                        android:text="Lock Screen"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp" />

                    <Button
                        android:id="@+id/btn_device_status"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_secondary"
                        android:text="Device Status"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Username & Telegram Admin Bot Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USER &amp; TELEGRAM ADMIN ALERTS"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/et_username"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:hint="Enter username"
                        android:textColorHint="#475569"
                        android:textColor="#FFFFFF"
                        android:inputType="textPersonName"
                        android:textSize="14sp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_register_user"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_button_secondary"
                        android:text="Register"
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_telegram_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Telegram Bot: Active"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_sync_telegram"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sync Admin Chat"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:padding="4dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom In-Call Controls Overlay -->
    <LinearLayout
        android:id="@+id/call_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#E60A0F1D"
        android:paddingTop="12dp"
        android:paddingBottom="32dp"
        android:visibility="gone">

        <!-- Call Status & Live ICE Counters -->
        <TextView
            android:id="@+id/tv_call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Connecting..."
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <TextView
            android:id="@+id/tv_call_ice_counters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Peers: 0 | Local ICE: 0 | Remote ICE: 0"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="10dp" />

        <!-- Remote Peer Command Bar during Active Call -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_remote_torch"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Peer Torch"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_remote_status"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Peer Status"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_remote_lock"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Peer Lock"
                android:textColor="#FCA5A5"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- Primary Call Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btn_toggle_mic"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_control_circle"
                android:src="@drawable/ic_mic"
                android:contentDescription="Toggle Microphone"
                android:padding="13dp" />

            <ImageButton
                android:id="@+id/btn_toggle_video"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_control_circle"
                android:src="@drawable/ic_videocam"
                android:contentDescription="Toggle Video Camera"
                android:padding="13dp" />

            <ImageButton
                android:id="@+id/btn_hangup"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_button_hangup"
                android:src="@drawable/ic_call_end"
                android:contentDescription="End Call"
                android:padding="15dp" />

            <ImageButton
                android:id="@+id/btn_switch_camera"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_control_circle"
                android:src="@drawable/ic_switch_camera"
                android:contentDescription="Flip Camera"
                android:padding="13dp" />

            <ImageButton
                android:id="@+id/btn_toggle_speaker"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_control_circle"
                android:src="@drawable/ic_volume_up"
                android:contentDescription="Toggle Speaker"
                android:padding="13dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
